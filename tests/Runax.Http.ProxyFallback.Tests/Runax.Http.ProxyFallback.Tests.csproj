<Project Sdk="Microsoft.NET.Sdk">
  <!-- Deliberately no reference to Runax.Http.SourceGenerator. Runax.Http keeps its generator
       PrivateAssets="all", so nothing here is generated: the contracts in this project are exactly
       the interfaces the runtime proxy exists for, and AddRunaxClient<T>() cannot find them. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Runax.Http/Runax.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
