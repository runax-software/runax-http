<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirrors the frameworks the transports target, so the suite can run on each of them. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <NoWarn>$(NoWarn);CS1591;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Runax.Http.Abstractions/Runax.Http.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- extensibility.core rather than xunit.v3: the latter requires an executable, and this is a
         library the transport test projects inherit from. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <!-- Kestrel, so the suite tests transports against a real server over real sockets. A stub
       HttpMessageHandler would only prove a transport can talk to a stub. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
