<Project>
  <!-- Deliberately does NOT import src/Directory.Build.props. That file multi-targets
       net8.0;net9.0;net10.0 and sets packaging properties for a shippable library; a source
       generator is neither. It must be a single netstandard2.0 assembly, because that is what
       loads inside the compiler, and it ships as an analyzer asset inside Runax.Http rather than
       as a package of its own. Inheriting TargetFrameworks and then overriding TargetFramework
       here would multi-target instead of replacing. -->
</Project>
