<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Declarative HTTP clients for .NET: annotate an interface, get an implementation at compile time. Includes the source generator, the request runtime, dependency-injection wiring, and the HttpClient transport.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Runax.Http.Abstractions/Runax.Http.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- The generator travels inside this package as an analyzer, so installing Runax.Http is all a
       consumer has to do. ReferenceOutputAssembly="false" keeps the generator's netstandard2.0
       assembly out of our compile references: it runs in the compiler, it is not part of the API. -->
  <ItemGroup>
    <ProjectReference Include="../Runax.Http.SourceGenerator/Runax.Http.SourceGenerator.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- Packs the generator into analyzers/dotnet/cs, which is where NuGet looks for one. The path is
       the generator's build output rather than a resolved item because pack runs on the outer build
       of this multi-targeted project; the ProjectReference above guarantees it exists by then. -->
  <ItemGroup>
    <None Include="../Runax.Http.SourceGenerator/bin/$(Configuration)/netstandard2.0/Runax.Http.SourceGenerator.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <!-- The runtime proxy names query keys with the generator's own formatter, compiled in from the same
       file, so a key cannot be spelled differently depending on which path implemented the client. -->
  <ItemGroup>
    <Compile Include="../Runax.Http.SourceGenerator/QueryNameFormatter.cs" Link="Proxy/QueryNameFormatter.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Runax.Http.Tests" />
  </ItemGroup>
</Project>
